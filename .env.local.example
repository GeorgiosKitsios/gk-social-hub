# ── Anthropic ─────────────────────────────────────────────────
# KI-Assistent (Text-Generierung im PostEditor)
NEXT_PUBLIC_ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Supabase ───────────────────────────────────────────────────
# Project URL: Supabase → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co

# Anon Key (öffentlich, für Browser-Clients): Supabase → Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service Role Key (GEHEIM – nur serverseitig!): Supabase → Settings → API → service_role
# WICHTIG: Diesen Key NIEMALS mit NEXT_PUBLIC_ prefixen – er bleibt server-only!
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── App ────────────────────────────────────────────────────────
# Öffentliche URL der deployed App (z. B. für OAuth Callbacks)
NEXT_PUBLIC_APP_URL=https://deine-domain.com

# ── Facebook ──────────────────────────────────────────────────
# Facebook App: developers.facebook.com → Deine App → Einstellungen → Allgemein
NEXT_PUBLIC_FACEBOOK_APP_ID=...
FACEBOOK_APP_SECRET=...
