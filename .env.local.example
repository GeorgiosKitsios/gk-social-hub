# ── Anthropic ─────────────────────────────────────────────────
# KI-Assistent (Text-Generierung im PostEditor, clientseitig – 4 Basis-Modi)
NEXT_PUBLIC_ANTHROPIC_API_KEY=sk-ant-api03-...

# Caption-Generierung aus Bildern via Claude Vision (server-only!)
# WICHTIG: KEIN NEXT_PUBLIC_-Prefix – dieser Key bleibt auf dem Server.
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Supabase ───────────────────────────────────────────────────
# Project URL: Supabase → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co

# Anon Key (öffentlich, für Browser-Clients): Supabase → Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service Role Key (GEHEIM – nur serverseitig!): Supabase → Settings → API → service_role
# WICHTIG: Diesen Key NIEMALS mit NEXT_PUBLIC_ prefixen – er bleibt server-only!
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── App ────────────────────────────────────────────────────────
# Öffentliche URL der deployed App (z. B. für OAuth Callbacks)
NEXT_PUBLIC_APP_URL=https://deine-domain.com

# ── Cron Jobs ─────────────────────────────────────────────────
# Geheimer Schlüssel für den Cron-Job-Endpoint (zufälligen String wählen)
# Hostinger Cron URL: https://deine-domain.com/api/cron/publish?secret=DEIN_WERT
CRON_SECRET=ein-langes-zufaelliges-geheimnis-hier

# ── Facebook ──────────────────────────────────────────────────
# Facebook App: developers.facebook.com → Deine App → Einstellungen → Allgemein
NEXT_PUBLIC_FACEBOOK_APP_ID=...
FACEBOOK_APP_SECRET=...

# ── Cloudinary (Medien-Uploads) ───────────────────────────────
# Kostenloser Account: cloudinary.com → Dashboard → Product Environment Credentials
# Alle drei Werte sind server-only (kein NEXT_PUBLIC_), das Secret bleibt geheim.
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...
